# OneTrust Configuration
# Get your credentials from OneTrust dashboard: https://my.onetrust.com/
# Domain Script ID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REACT_APP_ONETRUST_DOMAIN_SCRIPT_ID=YOUR-DOMAIN-SCRIPT-ID-HERE

# Optional: OneTrust environment (production, staging, dev)
REACT_APP_ONETRUST_ENV=production

# Backend API URL
REACT_APP_API_URL=https://nfl-teammates-game-production.up.railway.app
