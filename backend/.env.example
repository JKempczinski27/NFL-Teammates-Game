# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/nfl_games
NODE_ENV=development

# Server Configuration
PORT=3001

# Database Connection Pool Settings (for horizontal scaling)
# Reduce these values when running multiple instances
DB_POOL_MAX=20              # Maximum connections per instance (reduce when scaling)
DB_POOL_MIN=5               # Minimum idle connections
DB_STATEMENT_TIMEOUT=10000  # Query timeout in milliseconds
DB_QUERY_TIMEOUT=10000      # Overall query timeout

# Redis Configuration (required for horizontal scaling)
# Enables distributed caching and rate limiting across multiple instances
REDIS_URL=redis://localhost:6379

# Clustering Configuration (for vertical scaling on single instance)
# Set to 'true' to use all CPU cores on a single server
ENABLE_CLUSTERING=false     # true to enable Node.js clustering
CLUSTER_WORKERS=            # Leave blank to use all CPU cores, or specify number

# CORS Configuration
# Add your frontend URLs (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000,http://localhost:3002,http://localhost:5173

# Optional: Monitoring and Analytics
# Add your monitoring service keys here
# NEW_RELIC_LICENSE_KEY=your-key-here
# DATADOG_API_KEY=your-key-here
