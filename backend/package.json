{
  "name": "nfl-games-backend-consolidated",
  "version": "2.0.0",
  "description": "Consolidated backend for NFL Teammates, Journeyman, and NFL Trivia games",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "init-db": "node initDatabase.js",
    "init-db-consolidated": "psql $DATABASE_URL -f schema-consolidated.sql",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=integration --runInBand",
    "test:load": "cross-env NODE_ENV=test jest --testPathPattern=load --runInBand",
    "test:security": "cross-env NODE_ENV=test jest --testPathPattern=security --runInBand",
    "test:db": "node test-railway-connection.js",
    "setup:test": "bash setup-test-env.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "@sentry/node": "^7.99.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "express-slow-down": "^2.1.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "validator": "^13.15.15",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "artillery": "^2.0.0",
    "artillery-plugin-metrics-by-endpoint": "^1.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/tests/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nfl",
    "teammates",
    "journeyman",
    "trivia",
    "game",
    "express",
    "api",
    "postgresql",
    "consolidated"
  ],
  "author": "NFL Games Team",
  "license": "MIT"
}
