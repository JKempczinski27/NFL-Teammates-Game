# CONSOLIDATED ENVIRONMENT VARIABLES
# For all three NFL games: Teammates, Journeyman, Trivia

# ===================================
# REQUIRED VARIABLES
# ===================================

# Database Configuration
# This will be automatically set by Railway/Render when you add PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database

# Server Configuration
PORT=8080
NODE_ENV=production

# Admin Authentication
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING

# ===================================
# AWS S3 CONFIGURATION (Required for image uploads)
# ===================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your-bucket-name

# ===================================
# OPTIONAL VARIABLES (Recommended for Production)
# ===================================

# Redis (for caching - improves performance)
# Add Redis service in Railway/Render and paste URL here
# REDIS_URL=redis://default:password@host:port

# Sentry (for error tracking and monitoring)
# Sign up at https://sentry.io and create a project
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# MongoDB (for session storage - optional)
# MONGO_URL=mongodb://username:password@host:port/database

# Session Secret (for express-session)
# SESSION_SECRET=your-session-secret-here

# Frontend URLs (for CORS)
# FRONTEND_URL=https://your-frontend-url.com
# TEAMMATES_FRONTEND_URL=https://teammates.example.com
# JOURNEYMAN_FRONTEND_URL=https://journeyman.example.com
# TRIVIA_FRONTEND_URL=https://trivia.example.com

# JWT Secret (for Journeyman authentication)
# JWT_SECRET=your-jwt-secret-here

# ===================================
# GAME-SPECIFIC CONFIGURATION
# ===================================

# NFL Teammates Game
# No additional config needed

# Journeyman Game
# Supports advanced security features (WAF, CSRF protection)
# CSRF_SECRET=your-csrf-secret-here
# ENABLE_WAF=true

# NFL Trivia Game
# No additional config needed

# ===================================
# DEPLOYMENT NOTES
# ===================================
#
# Railway:
# 1. Create new Railway project
# 2. Add PostgreSQL database (DATABASE_URL auto-set)
# 3. Add Redis (optional) - REDIS_URL auto-set
# 4. Set ADMIN_API_KEY with secure random string
# 5. Set AWS credentials if using S3
# 6. Set SENTRY_DSN if using Sentry
# 7. Run migrations: railway run psql $DATABASE_URL -f schema-consolidated.sql
#
# Render:
# 1. Create Web Service from repository
# 2. Set Root Directory: nfl-teamates-game/backend
# 3. Create PostgreSQL database
# 4. Copy Internal Database URL to DATABASE_URL
# 5. Add Redis instance (optional)
# 6. Set all environment variables in Render dashboard
# 7. Run migrations via Render Shell: psql $DATABASE_URL -f schema-consolidated.sql
#
