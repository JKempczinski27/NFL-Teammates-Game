# OneTrust Configuration
# Get your Domain Script ID from OneTrust admin panel
# Example: 01234567-89ab-cdef-0123-456789abcdef
REACT_APP_ONETRUST_DOMAIN_SCRIPT_ID=YOUR-DOMAIN-ID-HERE

# Adobe Analytics Configuration (optional)
REACT_APP_ADOBE_REPORT_SUITE_ID=YOUR-RSID-HERE
REACT_APP_ADOBE_TRACKING_SERVER=YOUR-TRACKING-SERVER-HERE

# Backend API Configuration
REACT_APP_API_URL=http://localhost:3001
