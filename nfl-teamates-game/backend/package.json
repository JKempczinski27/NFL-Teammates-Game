{
  "name": "nfl-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:integration": "jest --testMatch='**/*.integration.test.js'",
    "test:unit": "jest --testMatch='**/*.unit.test.js'",
    "load:baseline": "artillery run tests/load/baseline.yml",
    "load:normal": "artillery run tests/load/normal-traffic.yml",
    "load:peak": "artillery run tests/load/game-day-peak.yml",
    "load:spike": "artillery run tests/load/viral-spike.yml",
    "load:soak": "artillery run tests/load/soak-test.yml",
    "load:all": "npm run load:baseline && npm run load:normal && npm run load:peak"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "artillery": "^2.0.0",
    "artillery-plugin-metrics-by-endpoint": "^1.4.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@types/jest": "^29.5.12",
    "axios": "^1.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/tests/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ]
  },
  "engines": {
    "node": "18.x"
  }
}