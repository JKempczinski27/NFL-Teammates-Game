# Database Configuration
# Railway will automatically set this variable
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis Configuration (Optional but recommended for caching)
# Add Redis to your Railway project and Railway will provide this URL
REDIS_URL=redis://default:password@host:6379

# Sentry Error Logging (Optional but recommended for production)
# Get your DSN from https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Node Environment
NODE_ENV=production

# Server Port (Railway will set this automatically)
PORT=8080
