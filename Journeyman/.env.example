# Journeyman Game Frontend Configuration

# Backend API URL
# For local development: http://localhost:8080
# For production: your deployed backend URL (e.g., https://your-app.railway.app)
REACT_APP_API_URL=http://localhost:8080

# Adobe Analytics (optional)
REACT_APP_ADOBE_DEV_REPORT_SUITE_ID=journeyman-dev
REACT_APP_ADOBE_DEV_TRACKING_SERVER=your-dev-tracking.sc.omtrdc.net
REACT_APP_ADOBE_ENABLED=false
